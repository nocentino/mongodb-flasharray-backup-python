# ============================================================================
# SHARED INFRASTRUCTURE (applies to every deployment)
# ============================================================================

# Pure Storage FlashArray
FA_ENDPOINT=<array-hostname-or-ip>
FA_USERNAME=<array-username>
# Authentication (direct REST). Two options:
#   * FA_USERNAME + FA_PASSWORD  -> directory login; authorizes on EVERY fleet member (recommended,
#                                   matches the PowerShell -Credential behavior).
#   * FA_APITOKEN                -> a FlashArray API token; only valid on the array that issued it.
# username/password is preferred when both are set. At least one option must be provided.
FA_APITOKEN=<array-api-token>
# FA_PASSWORD=<array-login-password>   # optional; enables directory login for fleet-wide access
# FA REST API version to pin (skips client version auto-negotiation). Match api/<version> (e.g. 2.51).
FA_API_VERSION=2.51

# Ops Manager
# OM_BASE_URL is the host+port only; the API path and version are added by config.py.
OM_BASE_URL=http://<ops-manager-host>:8080
OM_API_VERSION=v1.0
OM_GROUP_ID=<group-id>
OM_PUBLIC_KEY=<om-api-public-key>
OM_PRIVATE_KEY=<om-api-private-key>

# MongoDB agent tool paths + SSH user (same node image across the fleet)
SSH_USER=<ssh-username>
MONGOSH_PATH=<path-to-mongosh>
MONGO_TOOLS_BASE=<path-to-mongo-database-tools>

# ============================================================================
# DEFAULT DEPLOYMENT  (flat keys; used when no --deployment is given)
#
# A "deployment" is one MongoDB cluster backed by one FlashArray protection group.
# A single .env can describe several. Override any deployment-specific key below
# per deployment with a "<NAME>__" prefix (NAME upper-cased, hyphens -> underscores),
# then select it with `--deployment <name>`. Unset prefixed keys fall back to these
# flat keys, so an existing single-deployment .env keeps working unchanged.
#
# Resolution order: --deployment arg > MONGO_FA_BACKUP_DEPLOYMENT env > DEFAULT_DEPLOYMENT
# key (below, optional) > none (flat keys).
# ============================================================================
# DEFAULT_DEPLOYMENT=<name>            # optional: pick a default deployment by name

# TOPOLOGY: 'sharded' (route via mongos/listShards) or 'replicaset' (target the single RS directly).
TOPOLOGY=sharded
FA_CLUSTER_NAME=<cluster-name>
# Protection group name. Convention: <cluster-name>-pg
FA_PROTECTION_GROUP=<cluster-name>-pg
OM_CLUSTER_ID=<cluster-id>
# Sharded: a mongos router.  Replica set: ANY RS member (no mongos exists; counts/probes run here).
MONGOS_HOST=<mongos-or-rs-member-host>
MONGOS_PORT=27017
# CLUSTER_NODES is optional - fallback used only when Ops Manager is unreachable.
# `initialize-protection-groups` refreshes this automatically from OM discovery on each run.
# CLUSTER_NODES=<node-1>,<node-2>,<node-3>

# ============================================================================
# EXAMPLE second deployment: a standalone replica set, selected with
#   <command> --deployment my-rs
# Only deployment-specific keys are overridden; the shared infra above is reused.
# (For a replica set, enable OM third-party backup via the third-party `.../manage`
#  endpoint, NOT `backupConfigs statusName=STARTED` — the latter demands an OM
#  snapshot store, which third-party/FlashArray backup does not use.)
# ============================================================================
# MY_RS__TOPOLOGY=replicaset
# MY_RS__FA_CLUSTER_NAME=my-rs
# MY_RS__FA_PROTECTION_GROUP=my-rs-pg
# MY_RS__OM_CLUSTER_ID=<rs-cluster-id>
# MY_RS__MONGOS_HOST=<an-rs-member-host>
# MY_RS__MONGOS_PORT=27017
# MY_RS__CLUSTER_NODES=<rs-member-1>,<rs-member-2>,<rs-member-3>

# Filesystem mount holding the MongoDB data (dbPath lives under it). Default: /data/mongo.
# Override per deployment (e.g. AEN_PROD__MONGO_DATA_MOUNT=/u01/data).
#MONGO_DATA_MOUNT=/data/mongo
